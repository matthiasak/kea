# Build output — build.sh regenerates all of this.
build/
.zig-cache/
zig-out/
zig/.zig-cache/
zig/zig-out/
zig/nanoui/.zig-cache/
zig/nanoui/zig-out/
zig/zig-pkg/
.DS_Store

# Signing material that's tied to one Apple Developer account and should
# never be committed, even though the scripts happily run without it.
*.provisionprofile
*.p12
*.mobileprovision

# Google Drive sync's OAuth client (KEA_GDRIVE_CLIENT_ID/SECRET), read by build.sh.
.env
